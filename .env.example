# Prefer DATABASE_URL (Supabase / Neon / any Postgres)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Or use separate fields for local Postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=root
# DB_DATABASE=pkmns

PORT=3000

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SMTP (Gmail App Password recommended)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Ambal Nagar Admin <your@gmail.com>"
